rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// DEVELOPMENT RULES — Alora AI (alora-ai-1135b)
// Allows any authenticated user to read and write all storage objects.
// ⚠️  These rules must be tightened to per-user-path rules
//     before going to production.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
