rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// DEVELOPMENT RULES — Alora AI (alora-ai-1135b)
// Allows any authenticated user to read and write all documents.
// ⚠️  These rules must be tightened to per-collection, per-user rules
//     before going to production.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
